# juju tour: one file, every construct. DRAFT SPEC, nothing compiles this yet.
## Two hashes start a doc comment. It attaches to the item below it.
#
# Precedence, loosest to tightest:
#   or | and | not | == != < <= > >= | "|" | ^ | & | << >> | + - | * / // % |
#   prefix - ~ * & | postfix . [] ()
# Bitwise ops bind tighter than comparisons (Python, not C). No chaining.
# Four-space indent, tabs are an error. No semicolons. No truthiness.

import mem
import ps1.gpu as gpu
from math import sin, cos

# ---------- declarations: const, let, var ----------
# const = compile-time value, may have no address, inlined freely
# let   = set once at runtime, has an address, can live in ROM, can't be reassigned
# var   = mutable. At module level it's a mutable global.

const MAX_SPRITES: usize = 64
const PRIMES: [4]i32 = [2, 3, 5, 7]
const GP1 = bitcast(*volatile u32, usize(0x1F801814))   # hardware register

let SCREEN_W: i32 = 320
var frame: u32                          # zero-initialized (.bss)
var palette: [4]u16 = [0, 0x7FFF, 0x03E0, 0x001F]   # .data

@section(".bss")
@align(16)
var scratch: [65536]u8

# ---------- types ----------
struct Vec2:
    x: i16
    y: i16

@packed
struct Sprite:
    pos: Vec2
    tex: u8
    flags: u8

enum Mode: u8:
    idle
    run
    jump = 10

union Word:
    as_u32: u32
    as_bytes: [4]u8

static_assert(size_of(Sprite) == 6, "Sprite layout changed")

# ---------- compile-time conditionals ----------
when TARGET == "ps1":
    const SCREEN_H: i32 = 240
elif TARGET == "gba":
    const SCREEN_H: i32 = 160
else:
    const SCREEN_H: i32 = 480

# ---------- functions ----------
fn add(x: i32, y: i32 = 0) -> i32:          # default values, keyword calls: add(y=2, x=1)
    return x + y

fn divmod(a: i32, b: i32) -> (i32, i32):    # multiple returns: the only tuples
    return a / b, a % b

fn apply(f: fn(i32) -> i32, v: i32) -> i32: # function pointers, no closures
    return f(v)

fn max_of[T](a: T, b: T) -> T:              # generics: [T] after the name
    return a if a > b else b                # ternary

fn nothing():
    pass

fn _private_helper():                       # leading _ = not importable
    pass

# ---------- method-call sugar (the only OOP-flavored feature) ----------
# x.f(args) is rewritten to f(x, args), or f(&x, args) if f's first parameter
# is a pointer and x is addressable. No dispatch, no inheritance, no self.
# Lookup order: struct field first, then functions in scope.
fn move(v: *Vec2, dx: i16):
    v.x += dx                               # "." auto-dereferences pointers

fn length_sq(v: Vec2) -> i32:               # by-value first parameter also works
    return i32(v.x) * i32(v.x) + i32(v.y) * i32(v.y)

fn methods():
    var v = Vec2(x=1, y=2)                  # keyword construction
    var w = Vec2(3, 4)                      # positional
    v.move(5)                               # => move(&v, 5)
    var n = v.length_sq()                   # => length_sq(v)
    var p = &v
    p.move(1)                               # p is already a pointer: passed as-is
    var m = max_of(v.x, w.x)

# ---------- operators, casts, literals ----------
fn operators() -> i32:
    var a = 7 / 2                           # => 3, truncates toward zero (C)
    var b = -7 / 2                          # => -3
    var c = -7 // 2                         # => -4, floor division
    var d = -7 % 3                          # => -1, takes the sign of the left side
    var e = (0xF0 & 0x3C) | (1 << 4)
    var ok = a < 10 and not (b == 0) or c != d
    a += 1
    b //= 2
    c <<= 1
    var big = i64(a) * 1_000_000            # conversions are always explicit
    var bits = bitcast(u32, a)              # same-size reinterpret
    var wrap = u8(255) + 1                  # => 0, overflow wraps, never traps
    var chr = 'A'                           # u8
    var bin = 0b1010_0001
    let text: str = "hello"                 # (ptr, len), UTF-8, not null-terminated
    let ctext: cstr = c"hello"              # *u8, for C
    return a

# ---------- pointers ----------
fn pointers():
    var n: i32 = 7
    var p: *i32 = &n
    *p = 8                                  # write through
    var v = *p * *p                         # prefix * is deref, infix * is multiply
    var pp: **i32 = &p
    **pp = 3
    var s = Vec2(1, 2)
    var q = &s
    q.x = 1                                 # auto-deref
    (*q).x = 2                              # explicit form
    # *q.x means *(q.x): "." binds tighter than prefix *. Almost never what you want.
    *q = Vec2(0, 0)                         # whole-struct store
    var status = *GP1                       # volatile: real load, every time
    *GP1 = 0x03000000                       # volatile: real store
    var none: *i32 = nil
    if none == nil: pass

# ---------- arrays, slices, loops ----------
fn collections() -> i32:
    var arr: [4]i32 = [1, 2, 3, 4]
    var view: []i32 = arr[1:3]              # => [2, 3], end excluded, no copy
    var tail = arr[2:]
    var head = arr[:3]
    var last = arr[arr.len - 1]             # no negative indexes
    var total = 0
    for i in range(arr.len):                # 0 1 2 3
        total += arr[i]
    for i in range(4, 8, 2):                # 4 6
        total += i32(i)
    for item in arr:                        # item is a copy
        total += item
    for i, item in arr:                     # index and value
        total += i32(i) + item
    for &item in arr:                       # item is *i32, edit in place
        *item += 1
    var k = 0
    while true:
        k += 1
        if k < 3: continue
        if k > 5: break
    return total

# ---------- branching, match, defer ----------
fn branching(mode: Mode, n: i32) -> i32:
    if n > 10:
        return 1
    elif n < 0:
        return -1
    else:
        pass
    match mode:                             # no fallthrough, enums must be exhaustive
        case Mode.idle:
            return 0
        case Mode.run | Mode.jump:
            return 2
    return 3

# ---------- memory: allocators are explicit ----------
# in mem:  fn alloc[T](a: *Arena, n: usize) -> []T
# [T] after a generic name is a type argument; the checker tells it from indexing.
fn make_sprites(a: *mem.Arena) -> []Sprite:
    return a.alloc[Sprite](MAX_SPRITES)     # method sugar + explicit allocator

# ---------- errors: return values, like C, but the compiler nags ----------
@must_use                                   # warn if the caller ignores the result
fn find(items: []Sprite, tex: u8) -> (usize, bool):
    for i, s in items:
        if s.tex == tex: return i, true
    return 0, false

fn errors(items: []Sprite):
    var idx, found = find(items, 3)
    var _, ok = find(items, 4)
    if not found: panic("sprite 3 missing")
    assert(idx < items.len, "index out of range")   # checked in debug builds

# ---------- C interop and inline asm ----------
foreign "c":
    fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8
    @link_name("DrawSync")
    fn draw_sync(mode: i32) -> i32
    var errno: i32                          # foreign variables too

@inline
fn gte_write(reg: u32, val: u32):           # {names} become operands, $ passes through
    asm volatile("mtc2 {v}, ${reg}", v = in(val), reg = const(reg))

@inline
fn gte_read(reg: u32) -> u32:
    var out: u32
    asm volatile("mfc2 {o}, ${reg}\n nop", o = out(out), reg = const(reg), clobber("memory"))
    return out

@naked
@export("_start")
@section(".text.start")
fn start():
    asm volatile("lui $sp, 0x801F\n ori $sp, $sp, 0xFF00\n jal main\n nop")

# ---------- entry point ----------
@export("main")
fn main() -> i32:
    var arena = mem.arena_from(scratch[:])
    defer arena.reset()                     # runs when main exits, however it exits
    var sprites = make_sprites(&arena)
    let count = sprites.len                 # set once, runtime value
    # count = 0                             # ERROR: let can't be reassigned
    while true:
        frame += 1
        *GP1 = 0x05000000
    return 0

# ---------- misc attributes (go on the line above the item) ----------
# @inline @noinline @noreturn @naked @cold @used @weak @packed @align(N)
# @section(".x") @export("sym") @link_name("sym") @no_bounds_check
# @must_use @deprecated("msg")
#
# Keywords: fn var let const struct enum union if elif else while for in break
#   continue return match case defer import from as foreign asm when pass
#   and or not true false nil
