const TABLE: [4]i32 = [10, 20, 30, 40]
var counter: i32

struct P:
    x: i32
    y: i32

enum Mode: u8:
    idle
    run
    jump = 10

@export("jj_fdiv")
fn fdiv(a: i32, b: i32) -> i32:
    return a // b

@export("jj_div")
fn tdiv(a: i32, b: i32) -> i32:
    return a / b

@export("jj_mod")
fn rem(a: i32, b: i32) -> i32:
    return a % b

@export("jj_shr")
fn shr(a: i32) -> i32:
    return a >> 2

@export("jj_sum")
fn sum_to(n: i32) -> i32:
    var t = 0
    for i in range(n):
        t += i
    return t

@export("jj_arr")
fn arr_test() -> i32:
    var a: [4]i32 = [1, 2, 3, 4]
    var total = 0
    for x in a:
        total += x
    for &x in a:
        *x += 1
    for i, x in a:
        total += i32(i) * x
    return total + a[3]

fn move(p: *P, dx: i32):
    p.x += dx

@export("jj_struct")
fn st_test() -> i32:
    var p = P(x = 1, y = 2)
    p.move(5)
    return p.x * 10 + p.y

@export("jj_sc")
fn sc(a: i32, b: i32) -> i32:
    if a > 0 and b > 0:
        return 1
    elif a > 0 or b > 0:
        return 2
    else:
        return 3

@export("jj_tern")
fn tern(a: i32) -> i32:
    return 10 if a > 5 else 20

fn helper():
    defer counter += 100
    counter += 1

@export("jj_defer")
fn defer_test() -> i32:
    counter = 0
    helper()
    return counter

@export("jj_slice")
fn slice_test() -> i32:
    var a: [5]i32 = [1, 2, 3, 4, 5]
    var s = a[1:4]
    return i32(s.len) * 100 + s[0]

@export("jj_str")
fn str_test() -> i32:
    let s = "hello"
    return i32(s.len)

@export("jj_enum")
fn enum_test() -> i32:
    return i32(Mode.jump) + i32(Mode.run)

@export("jj_u8")
fn u8_test() -> i32:
    var b: u8 = 200
    var c = b + 100
    return i32(c)

@export("jj_tab")
fn tab(i: i32) -> i32:
    return TABLE[i]

@export("jj_early")
fn early(n: i32) -> i32:
    var t = 0
    for i in range(n):
        if i == 2: continue
        if i == 5: break
        t += i
    return t

@export("jj_default")
fn with_default(x: i32, y: i32 = 7) -> i32:
    return x * 100 + y

@export("jj_dcall")
fn dcall() -> i32:
    return with_default(1) + with_default(y = 2, x = 3)

@export("jj_negfloor")
fn neg_floor() -> i32:
    return -7 // 2

@export("jj_ptr")
fn ptr_test() -> i32:
    var n: i32 = 7
    var p = &n
    *p = *p * 3
    return n

@export("jj_global")
fn global_test() -> i32:
    counter = 5
    counter += 2
    return counter

@export("jj_while")
fn while_test() -> i32:
    var i = 0
    var t = 0
    while i < 5:
        i += 1
        t += i
    return t

@export("jj_idx8")
fn idx8() -> i32:
    var big: [256]i32
    big[200] = 77
    var i: u8 = 200
    return big[i]
