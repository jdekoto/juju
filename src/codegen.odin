package juju

import "core:fmt"
import "core:strings"

// ===========================================================================
// LLVM IR text generator.
//
// Input:  the typed AST plus the `Sema` the checker produced.
// Output: the text of a .ll file. Every local gets an `alloca` (hoisted to the
// function's entry block) and is read with load / written with store; LLVM's
// mem2reg pass turns that into proper SSA, so we never build SSA by hand.
// ===========================================================================

Loop_Ctx :: struct {
    break_label:    string,
    continue_label: string,
    defer_depth:    int, // how many defer scopes were open when the loop began
}

Gen :: struct {
    sema:            ^Sema,
    diags:           ^[dynamic]Diagnostic,
    types_out:       strings.Builder, // %struct.X = type { ... }
    globals_out:     strings.Builder, // @globals and string constants
    funcs_out:       strings.Builder, // finished functions
    body:            strings.Builder, // the function currently being generated
    allocas:         strings.Builder, // its hoisted allocas
    tmp, labels:     int,             // per function
    str_count:       int,             // per module
    local_count:     int,
    cur_block:       string,          // label of the block we're appending to
    terminated:      bool,            // the current block already ended in br/ret
    loops:           [dynamic]Loop_Ctx,
    defers:          [dynamic][dynamic]^Stmt,
    ret_type:        ^Type,
    emitted_structs: map[string]bool,
}

gen_err :: proc(g: ^Gen, span: Span, msg: string, hint := "") {
    report(g.diags, span, msg, hint)
}

// Returns the module text. If it reports errors (unsupported features), don't use the text.
generate :: proc(sema: ^Sema, diags: ^[dynamic]Diagnostic) -> string {
    g := Gen{sema = sema, diags = diags}
    g.types_out   = strings.builder_make()
    g.globals_out = strings.builder_make()
    g.funcs_out   = strings.builder_make()
    g.body        = strings.builder_make()
    g.allocas     = strings.builder_make()
    g.emitted_structs = make(map[string]bool)

    gen_globals(&g)
    for d in sema.decls {
        f, is_fn := d.variant.(Fn_Decl)
        if !is_fn { continue }
        sym, found := sema.decl_syms[d]
        if !found || sym.is_generic || is_invalid(sym.type) { continue }
        if sym.is_extern {
            gen_extern(&g, f, sym)
        } else {
            gen_fn(&g, d, f, sym)
        }
    }

    out := strings.builder_make()
    fmt.sbprintf(&out, "; generated by juju (target: %s)\n", sema.target)
    switch sema.target {
    case "ps1": fmt.sbprintf(&out, "target triple = \"mipsel-none-unknown-elf\"\n")
    case "gba": fmt.sbprintf(&out, "target triple = \"armv4t-none-eabi\"\n")
    }
    fmt.sbprintf(&out, "\n%s\n%s\n%s", strings.to_string(g.types_out), strings.to_string(g.globals_out), strings.to_string(g.funcs_out))
    return strings.to_string(out)
}

// ===========================================================================
// Types, sizes and layout
// ===========================================================================

ptr_int :: proc(g: ^Gen) -> string {
    return "i32" if g.sema.ptr_bits == 32 else "i64"
}

slice_ll :: proc(g: ^Gen) -> string {
    return fmt.aprintf("{{ ptr, %s }}", ptr_int(g))
}

ll_type :: proc(g: ^Gen, t: ^Type) -> string {
    if t == nil { return "i32" }
    switch v in t.info {
    case Basic_Type:
        #partial switch v.kind {
        case .Void:                 return "void"
        case .Bool:                 return "i1"
        case .I8, .U8:              return "i8"
        case .I16, .U16:            return "i16"
        case .I32, .U32:            return "i32"
        case .Untyped_Int:          return "i32" // the checker defaults leftovers to i32
        case .I64, .U64:            return "i64"
        case .Isize, .Usize:        return ptr_int(g)
        case .Str:                  return slice_ll(g)
        case .Cstr, .Untyped_Nil:   return "ptr"
        case .F32, .F64:
            gen_err(g, Span{}, "floating point isn't supported by the code generator yet")
            return "i32"
        }
        return "i32"
    case Pointer_Type: return "ptr"
    case Func_Type:    return "ptr"
    case Slice_Type:   return slice_ll(g)
    case Array_Type:   return fmt.aprintf("[%d x %s]", v.len, ll_type(g, v.elem))
    case Enum_Type:    return ll_type(g, v.base)
    case Struct_Type:  return struct_ll(g, t)
    case Tuple_Type:
        gen_err(g, Span{}, "tuples (multiple return values) aren't supported by the code generator yet")
        return "i32"
    }
    return "i32"
}

align_up :: proc(n, a: int) -> int {
    if a <= 1 { return n }
    return (n + a - 1) / a * a
}

size_align :: proc(g: ^Gen, t: ^Type) -> (size, align: int) {
    pb := g.sema.ptr_bits / 8
    if t == nil { return 4, 4 }
    switch v in t.info {
    case Basic_Type:
        #partial switch v.kind {
        case .Bool, .I8, .U8:                      return 1, 1
        case .I16, .U16:                           return 2, 2
        case .I32, .U32, .Untyped_Int:             return 4, 4
        case .I64, .U64:                           return 8, 8
        case .Isize, .Usize, .Cstr, .Untyped_Nil:  return pb, pb
        case .Str:                                 return 2 * pb, pb
        }
        return 4, 4
    case Pointer_Type, Func_Type: return pb, pb
    case Slice_Type:              return 2 * pb, pb
    case Array_Type:
        es, ea := size_align(g, v.elem)
        return es * int(v.len), ea
    case Enum_Type:   return size_align(g, v.base)
    case Tuple_Type:  return 0, 1
    case Struct_Type:
        size = 0
        align = 1
        for f in v.fields {
            fs, fa := size_align(g, f.type)
            if v.packed { fa = 1 }
            if v.is_union {
                size = max(size, fs)
            } else {
                size = align_up(size, fa) + fs
            }
            align = max(align, fa)
        }
        return align_up(size, align), align
    }
    return 4, 4
}

// The %struct.Name type: defined the first time it's used.
struct_ll :: proc(g: ^Gen, t: ^Type) -> string {
    st := t.info.(Struct_Type)
    name := fmt.aprintf("%%struct.%s", st.name)
    if name in g.emitted_structs { return name }
    g.emitted_structs[name] = true

    body: string
    if st.is_union {
        // a union is an array of its most-aligned integer unit, big enough for the largest field
        size, align := size_align(g, t)
        unit := "i8"
        switch align {
        case 2: unit = "i16"
        case 4: unit = "i32"
        case 8: unit = "i64"
        }
        body = fmt.aprintf("{{ [%d x %s] }}", max(size / align, 1), unit)
    } else {
        sb := strings.builder_make()
        strings.write_string(&sb, "<{ " if st.packed else "{ ")
        for f, i in st.fields {
            if i > 0 { strings.write_string(&sb, ", ") }
            strings.write_string(&sb, ll_type(g, f.type))
        }
        strings.write_string(&sb, " }>" if st.packed else " }")
        body = strings.to_string(sb)
    }
    fmt.sbprintf(&g.types_out, "%s = type %s\n", name, body)
    return name
}

// ===========================================================================
// Small helpers: attributes, names, strings, constants
// ===========================================================================

attr_string :: proc(d: ^Decl, name: string) -> (string, bool) {
    for a in d.attrs {
        if a.name == name && len(a.args) > 0 {
            if lit, ok := a.args[0].variant.(Str_Lit); ok { return lit.text[1:len(lit.text) - 1], true }
        }
    }
    return "", false
}

attr_int :: proc(d: ^Decl, name: string) -> (int, bool) {
    for a in d.attrs {
        if a.name == name && len(a.args) > 0 {
            if lit, ok := a.args[0].variant.(Int_Lit); ok { return int(lit.value), true }
        }
    }
    return 0, false
}

// The linker-visible name: @export("x") / @link_name("x") win over the juju name.
symbol_name :: proc(sym: ^Symbol) -> string {
    if sym.decl != nil {
        if n, ok := attr_string(sym.decl, "export"); ok { return n }
        if n, ok := attr_string(sym.decl, "link_name"); ok { return n }
    }
    return sym.name
}

unescape_string :: proc(raw: string) -> []u8 { // `raw` includes the quotes
    inner := raw[1:len(raw) - 1]
    out: [dynamic]u8
    i := 0
    for i < len(inner) {
        c := inner[i]
        if c == '\\' && i + 1 < len(inner) {
            i += 1
            switch inner[i] {
            case 'n': append(&out, '\n')
            case 'r': append(&out, '\r')
            case 't': append(&out, '\t')
            case '0': append(&out, 0)
            case:     append(&out, inner[i]) // \\ \" \' and anything else: the character itself
            }
        } else {
            append(&out, c)
        }
        i += 1
    }
    return out[:]
}

llvm_escape :: proc(bytes: []u8) -> string {
    sb := strings.builder_make()
    for b in bytes {
        if b >= 32 && b < 127 && b != '"' && b != '\\' {
            strings.write_byte(&sb, b)
        } else {
            fmt.sbprintf(&sb, "\\%02X", b)
        }
    }
    return strings.to_string(sb)
}

// Emits a string constant global. Returns its name and byte length (without the NUL).
make_string_global :: proc(g: ^Gen, raw: string, is_c: bool) -> (string, int) {
    bytes := unescape_string(raw)
    name := fmt.aprintf("@.str.%d", g.str_count)
    g.str_count += 1
    n := len(bytes)
    text := llvm_escape(bytes)
    if is_c {
        fmt.sbprintf(&g.globals_out, "%s = private unnamed_addr constant [%d x i8] c\"%s\\00\"\n", name, n + 1, text)
    } else {
        fmt.sbprintf(&g.globals_out, "%s = private unnamed_addr constant [%d x i8] c\"%s\"\n", name, n, text)
    }
    return name, n
}

// An integer constant printed the way LLVM wants it for type `t` (wrapped to its width).
int_const_text :: proc(g: ^Gen, value: i64, t: ^Type) -> string {
    if is_bool(t) { return "true" if value != 0 else "false" }
    bits := int_bits(t, g.sema.ptr_bits)
    if bits <= 0 || bits >= 64 { return fmt.aprintf("%d", value) }
    v := value & ((i64(1) << u64(bits)) - 1)
    if v >= (i64(1) << u64(bits - 1)) { v -= i64(1) << u64(bits) }
    return fmt.aprintf("%d", v)
}

// Compile-time integer evaluation: literals, consts, + - * / // % & | ^ << >>, conversions, enum members.
const_int :: proc(g: ^Gen, e: ^Expr) -> (i64, bool) {
    #partial switch v in e.variant {
    case Int_Lit:  return i64(v.value), true
    case Char_Lit: return i64(v.value), true
    case Bool_Lit: return 1 if v.value else 0, true
    case Ident:
        if e.sym != nil && e.sym.kind == .Const && e.sym.init != nil { return const_int(g, e.sym.init) }
    case Field: // Mode.run
        if v.base.type == nil && e.type != nil {
            if en, ok := e.type.info.(Enum_Type); ok {
                for m, i in en.members { if m == v.name { return en.values[i], true } }
            }
        }
    case Unary:
        x, ok := const_int(g, v.operand)
        if !ok { return 0, false }
        #partial switch v.op {
        case .Neg:     return -x, true
        case .Bit_Not: return ~x, true
        }
    case Binary:
        a, ok1 := const_int(g, v.lhs)
        b, ok2 := const_int(g, v.rhs)
        if !ok1 || !ok2 { return 0, false }
        #partial switch v.op {
        case .Add:     return a + b, true
        case .Sub:     return a - b, true
        case .Mul:     return a * b, true
        case .Div:     if b != 0 { return a / b, true }
        case .Floor_Div:
            if b != 0 {
                q := a / b
                if (a % b != 0) && ((a < 0) != (b < 0)) { q -= 1 }
                return q, true
            }
        case .Mod:     if b != 0 { return a % b, true }
        case .Bit_And: return a & b, true
        case .Bit_Or:  return a | b, true
        case .Bit_Xor: return a ~ b, true
        case .Shl:     return a << u64(b), true
        case .Shr:     return a >> u64(b), true
        }
    case Call: // u32(5), usize(0x1F80...)
        if v.callee.sym != nil && v.callee.sym.kind == .Type && len(v.args) == 1 && is_basic(v.callee.sym.type) {
            return const_int(g, v.args[0].value)
        }
    }
    return 0, false
}

// The body of an LLVM constant for a value of type `t` (the caller prefixes the type).
gen_const :: proc(g: ^Gen, e: ^Expr, t: ^Type) -> (string, bool) {
    not_const :: proc(g: ^Gen, e: ^Expr) -> (string, bool) {
        gen_err(g, e.span, "this isn't a compile-time constant", "globals can only be initialized with literals, consts, and constructors of those")
        return "zeroinitializer", false
    }

    if is_integer(t) || is_enum(t) || is_bool(t) {
        if v, ok := const_int(g, e); ok { return int_const_text(g, v, t), true }
        return not_const(g, e)
    }

    #partial switch v in e.variant {
    case Ident: // a const referring to another const
        if e.sym != nil && e.sym.kind == .Const && e.sym.init != nil { return gen_const(g, e.sym.init, t) }
    case Nil_Lit:
        return "null", true
    case Str_Lit:
        name, n := make_string_global(g, v.text, v.is_c)
        if v.is_c { return name, true }
        return fmt.aprintf("{{ ptr %s, %s %d }}", name, ptr_int(g), n), true
    case Array_Lit:
        if arr, ok := t.info.(Array_Type); ok {
            sb := strings.builder_make()
            strings.write_string(&sb, "[ ")
            for el, i in v.elems {
                body, _ := gen_const(g, el, arr.elem)
                if i > 0 { strings.write_string(&sb, ", ") }
                fmt.sbprintf(&sb, "%s %s", ll_type(g, arr.elem), body)
            }
            strings.write_string(&sb, " ]")
            return strings.to_string(sb), true
        }
    case Call:
        if id, ok := v.callee.variant.(Ident); ok && id.name == "bitcast" && len(v.args) == 2 && is_pointer(t) {
            if n, ok2 := const_int(g, v.args[1].value); ok2 {
                return fmt.aprintf("inttoptr (%s %s to ptr)", ptr_int(g), int_const_text(g, n, ty_usize)), true
            }
        }
        if v.callee.sym != nil && v.callee.sym.kind == .Type {
            if st, ok := t.info.(Struct_Type); ok && !st.is_union {
                vals := make([]string, len(st.fields))
                defer delete(vals)
                for i in 0 ..< len(vals) { vals[i] = "zeroinitializer" }
                for arg, i in v.args {
                    idx := i
                    if arg.name != "" {
                        for f, j in st.fields { if f.name == arg.name { idx = j } }
                    }
                    vals[idx], _ = gen_const(g, arg.value, st.fields[idx].type)
                }
                sb := strings.builder_make()
                strings.write_string(&sb, "<{ " if st.packed else "{ ")
                for f, i in st.fields {
                    if i > 0 { strings.write_string(&sb, ", ") }
                    fmt.sbprintf(&sb, "%s %s", ll_type(g, f.type), vals[i])
                }
                strings.write_string(&sb, " }>" if st.packed else " }")
                return strings.to_string(sb), true
            }
        }
    }
    return not_const(g, e)
}

// ===========================================================================
// Emitting instructions
// ===========================================================================

fresh :: proc(g: ^Gen) -> string {
    g.tmp += 1
    return fmt.aprintf("%%t%d", g.tmp)
}

new_label :: proc(g: ^Gen, base: string) -> string {
    g.labels += 1
    return fmt.aprintf("%s.%d", base, g.labels)
}

// Code after a return/break/continue is unreachable, but LLVM still wants a
// valid block, so start a new (dead) one.
start_dead_block :: proc(g: ^Gen) {
    label := new_label(g, "dead")
    fmt.sbprintf(&g.body, "%s:\n", label)
    g.terminated = false
    g.cur_block = label
}

emit :: proc(g: ^Gen, format: string, args: ..any) {
    if g.terminated { start_dead_block(g) }
    fmt.sbprintf(&g.body, "  ")
    fmt.sbprintf(&g.body, format, ..args)
    fmt.sbprintf(&g.body, "\n")
}

// Emit a block terminator (br / ret / unreachable).
emit_term :: proc(g: ^Gen, format: string, args: ..any) {
    if g.terminated { return }
    fmt.sbprintf(&g.body, "  ")
    fmt.sbprintf(&g.body, format, ..args)
    fmt.sbprintf(&g.body, "\n")
    g.terminated = true
}

// Start a new block. If the current one is still open, fall through into it.
emit_label :: proc(g: ^Gen, name: string) {
    if !g.terminated { fmt.sbprintf(&g.body, "  br label %%%s\n", name) }
    fmt.sbprintf(&g.body, "%s:\n", name)
    g.terminated = false
    g.cur_block = name
}

// A stack slot in the function's entry block.
alloc_local :: proc(g: ^Gen, name: string, t: ^Type) -> string {
    g.local_count += 1
    reg := fmt.aprintf("%%%s.%d", name, g.local_count)
    fmt.sbprintf(&g.allocas, "  %s = alloca %s\n", reg, ll_type(g, t))
    return reg
}

int_cast :: proc(g: ^Gen, val: string, from, to: ^Type) -> string {
    fb := int_bits(from, g.sema.ptr_bits)
    tb := int_bits(to, g.sema.ptr_bits)
    if fb == tb || fb == 0 || tb == 0 { return val }
    r := fresh(g)
    if tb < fb {
        emit(g, "%s = trunc %s %s to %s", r, ll_type(g, from), val, ll_type(g, to))
    } else if is_signed(from) {
        emit(g, "%s = sext %s %s to %s", r, ll_type(g, from), val, ll_type(g, to))
    } else {
        emit(g, "%s = zext %s %s to %s", r, ll_type(g, from), val, ll_type(g, to))
    }
    return r
}

// Value conversions for T(x): integers, bools, enums, pointers -> integers.
convert :: proc(g: ^Gen, val: string, from, to: ^Type, span: Span) -> string {
    if types_equal(from, to) { return val }
    if is_pointer(from) {
        r := fresh(g)
        emit(g, "%s = ptrtoint ptr %s to %s", r, val, ptr_int(g))
        return int_cast(g, r, ty_usize, to)
    }
    if int_bits(from, g.sema.ptr_bits) > 0 && int_bits(to, g.sema.ptr_bits) > 0 {
        return int_cast(g, val, from, to)
    }
    gen_err(g, span, fmt.aprintf("can't convert '%s' to '%s' in generated code yet", type_name(from), type_name(to)))
    return val
}

// ===========================================================================
// Globals and functions
// ===========================================================================

gen_globals :: proc(g: ^Gen) {
    for d in g.sema.decls {
        v, is_var := d.variant.(Var_Decl)
        if !is_var { continue }
        sym, found := g.sema.decl_syms[d]
        if !found || is_invalid(sym.type) { continue }
        t := sym.type
        // scalar consts are inlined at every use; they need no storage
        if v.binding == .Const && (is_basic(t) || is_pointer(t) || is_enum(t)) { continue }

        init := "zeroinitializer"
        if v.value != nil { init, _ = gen_const(g, v.value, t) }
        keyword := "global" if v.binding == .Var else "constant"
        linkage := "" if has_attr(d, "export") else "internal "
        extra := ""
        if sec, ok := attr_string(d, "section"); ok { extra = fmt.aprintf(", section \"%s\"", sec) }
        if al, ok := attr_int(d, "align"); ok { extra = fmt.aprintf("%s, align %d", extra, al) }
        fmt.sbprintf(&g.globals_out, "@%s = %s%s %s %s%s\n", symbol_name(sym), linkage, keyword, ll_type(g, t), init, extra)
    }
}

gen_extern :: proc(g: ^Gen, f: Fn_Decl, sym: ^Symbol) {
    ft := sym.type.info.(Func_Type)
    params := strings.builder_make()
    for pt, i in ft.param_types {
        if i > 0 { strings.write_string(&params, ", ") }
        strings.write_string(&params, ll_type(g, pt))
    }
    fmt.sbprintf(&g.funcs_out, "declare %s @%s(%s)\n\n", ll_type(g, ft.ret), symbol_name(sym), strings.to_string(params))
}

gen_fn :: proc(g: ^Gen, d: ^Decl, f: Fn_Decl, sym: ^Symbol) {
    ft := sym.type.info.(Func_Type)

    g.tmp = 0
    g.labels = 0
    g.local_count = 0
    g.terminated = false
    g.cur_block = "start"
    g.ret_type = ft.ret
    strings.builder_reset(&g.body)
    strings.builder_reset(&g.allocas)
    clear(&g.loops)
    clear(&g.defers)

    // header
    params := strings.builder_make()
    for pt, i in ft.param_types {
        if i > 0 { strings.write_string(&params, ", ") }
        fmt.sbprintf(&params, "%s %%arg.%d", ll_type(g, pt), i)
    }
    attrs := "nounwind"
    if has_attr(d, "inline")   { attrs = "alwaysinline nounwind" }
    if has_attr(d, "noinline") { attrs = "noinline nounwind" }
    if has_attr(d, "naked")    { attrs = fmt.aprintf("naked %s", attrs) }
    if has_attr(d, "noreturn") { attrs = fmt.aprintf("noreturn %s", attrs) }
    if has_attr(d, "cold")     { attrs = fmt.aprintf("cold %s", attrs) }
    linkage := "internal "
    if has_attr(d, "export") { linkage = "" }
    if has_attr(d, "weak")   { linkage = "weak " }
    section := ""
    if sec, ok := attr_string(d, "section"); ok { section = fmt.aprintf(" section \"%s\"", sec) }

    // body: spill every parameter into a stack slot so it can be assigned to
    psyms := g.sema.param_syms[d]
    fmt.sbprintf(&g.body, "start:\n")
    append(&g.defers, make([dynamic]^Stmt))
    for i in 0 ..< len(f.params) {
        reg := alloc_local(g, f.params[i].name, ft.param_types[i])
        psyms[i].ir_name = reg
        fmt.sbprintf(&g.body, "  store %s %%arg.%d, ptr %s\n", ll_type(g, ft.param_types[i]), i, reg)
    }
    for s in f.body { gen_stmt(g, s) }
    pop_defer_scope(g, true)
    if !g.terminated {
        if is_void(ft.ret) { emit_term(g, "ret void") } else { emit_term(g, "unreachable") } // TODO: "missing return" is a checker error
    }

    fmt.sbprintf(&g.funcs_out, "define %s%s @%s(%s) %s%s {{\nentry:\n%s  br label %%start\n%s}}\n\n",
        linkage, ll_type(g, ft.ret), symbol_name(sym), strings.to_string(params), attrs, section,
        strings.to_string(g.allocas), strings.to_string(g.body))
}

// ===========================================================================
// defer
// ===========================================================================

push_defer_scope :: proc(g: ^Gen) {
    append(&g.defers, make([dynamic]^Stmt))
}

pop_defer_scope :: proc(g: ^Gen, run: bool) {
    scope := g.defers[len(g.defers) - 1]
    if run && !g.terminated {
        for i := len(scope) - 1; i >= 0; i -= 1 { gen_stmt(g, scope[i]) }
    }
    delete(scope)
    pop(&g.defers)
}

// Run deferred statements of every open scope from the innermost down to `depth`
// (without closing them): used by return, break and continue.
run_defers_down_to :: proc(g: ^Gen, depth: int) {
    for i := len(g.defers) - 1; i >= depth; i -= 1 {
        scope := g.defers[i]
        for j := len(scope) - 1; j >= 0; j -= 1 { gen_stmt(g, scope[j]) }
    }
}

// ===========================================================================
// Statements
// ===========================================================================

gen_block :: proc(g: ^Gen, body: [dynamic]^Stmt) {
    push_defer_scope(g)
    for s in body { gen_stmt(g, s) }
    pop_defer_scope(g, true)
}

assign_to_binop :: proc(op: Assign_Op) -> Binary_Op {
    switch op {
    case .Set, .Add:   return .Add
    case .Sub:         return .Sub
    case .Mul:         return .Mul
    case .Div:         return .Div
    case .Floor_Div:   return .Floor_Div
    case .Mod:         return .Mod
    case .Bit_And:     return .Bit_And
    case .Bit_Or:      return .Bit_Or
    case .Bit_Xor:     return .Bit_Xor
    case .Shl:         return .Shl
    case .Shr:         return .Shr
    }
    return .Add
}

gen_stmt :: proc(g: ^Gen, s: ^Stmt) {
    switch v in s.variant {
    case Var_Decl:
        sym := g.sema.local_syms[s]
        if sym == nil || is_invalid(sym.type) { return }
        sym.ir_name = alloc_local(g, sym.name, sym.type)
        ty := ll_type(g, sym.type)
        if v.value != nil {
            val := gen_expr(g, v.value)
            emit(g, "store %s %s, ptr %s", ty, val, sym.ir_name)
        } else {
            emit(g, "store %s zeroinitializer, ptr %s", ty, sym.ir_name) // no initializer means zero
        }
    case Assign:
        gen_assign(g, v)
    case Expr_Stmt:
        gen_expr(g, v.expr)
    case If_Stmt:
        end := new_label(g, "if.end")
        for b in v.branches {
            then_l := new_label(g, "if.then")
            next_l := new_label(g, "if.next")
            cond := gen_expr(g, b.cond)
            emit_term(g, "br i1 %s, label %%%s, label %%%s", cond, then_l, next_l)
            emit_label(g, then_l)
            gen_block(g, b.body)
            emit_term(g, "br label %%%s", end)
            emit_label(g, next_l)
        }
        gen_block(g, v.else_body)
        emit_label(g, end)
    case While_Stmt:
        cond_l := new_label(g, "while.cond")
        body_l := new_label(g, "while.body")
        end_l  := new_label(g, "while.end")
        emit_label(g, cond_l)
        cond := gen_expr(g, v.cond)
        emit_term(g, "br i1 %s, label %%%s, label %%%s", cond, body_l, end_l)
        emit_label(g, body_l)
        append(&g.loops, Loop_Ctx{break_label = end_l, continue_label = cond_l, defer_depth = len(g.defers)})
        gen_block(g, v.body)
        pop(&g.loops)
        emit_term(g, "br label %%%s", cond_l)
        emit_label(g, end_l)
    case For_Stmt:
        gen_for(g, s, v)
    case Return_Stmt:
        if v.value != nil {
            val := gen_expr(g, v.value)
            run_defers_down_to(g, 0)
            emit_term(g, "ret %s %s", ll_type(g, g.ret_type), val)
        } else {
            run_defers_down_to(g, 0)
            emit_term(g, "ret void")
        }
    case Break_Stmt:
        ctx := g.loops[len(g.loops) - 1]
        run_defers_down_to(g, ctx.defer_depth)
        emit_term(g, "br label %%%s", ctx.break_label)
    case Continue_Stmt:
        ctx := g.loops[len(g.loops) - 1]
        run_defers_down_to(g, ctx.defer_depth)
        emit_term(g, "br label %%%s", ctx.continue_label)
    case Pass_Stmt:
    case Defer_Stmt:
        append(&g.defers[len(g.defers) - 1], v.body)
    }
}

gen_assign :: proc(g: ^Gen, v: Assign) {
    addr := gen_addr(g, v.target)
    tt := v.target.type
    ty := ll_type(g, tt)
    vol := "volatile " if lvalue_volatile(v.target) else ""
    val: string
    if v.op == .Set {
        val = gen_expr(g, v.value)
    } else {
        cur := fresh(g)
        emit(g, "%s = load %s%s, ptr %s", cur, vol, ty, addr)
        rhs := gen_expr(g, v.value)
        val = gen_binop(g, assign_to_binop(v.op), cur, rhs, tt, v.value.type)
    }
    emit(g, "store %s%s %s, ptr %s", vol, ty, val, addr)
}

gen_for :: proc(g: ^Gen, s: ^Stmt, v: For_Stmt) {
    item := g.sema.local_syms[s]
    if item == nil || is_invalid(item.type) { return }
    cond_l := new_label(g, "for.cond")
    body_l := new_label(g, "for.body")
    inc_l  := new_label(g, "for.inc")
    end_l  := new_label(g, "for.end")

    if call, ok := v.iterable.variant.(Call); ok && call.callee.sym == nil {
        // for i in range(start, end, step)   (step must be positive)
        lt := item.type
        ty := ll_type(g, lt)
        start, limit, step := "0", "", "1"
        switch len(call.args) {
        case 1:
            limit = gen_expr(g, call.args[0].value)
        case 2:
            start = gen_expr(g, call.args[0].value)
            limit = gen_expr(g, call.args[1].value)
        case:
            start = gen_expr(g, call.args[0].value)
            limit = gen_expr(g, call.args[1].value)
            step  = gen_expr(g, call.args[2].value)
        }
        item.ir_name = alloc_local(g, v.item_name, lt)
        emit(g, "store %s %s, ptr %s", ty, start, item.ir_name)
        emit_label(g, cond_l)
        cur := fresh(g)
        emit(g, "%s = load %s, ptr %s", cur, ty, item.ir_name)
        c := fresh(g)
        emit(g, "%s = icmp %s %s %s, %s", c, "slt" if is_signed(lt) else "ult", ty, cur, limit)
        emit_term(g, "br i1 %s, label %%%s, label %%%s", c, body_l, end_l)
        emit_label(g, body_l)
        append(&g.loops, Loop_Ctx{break_label = end_l, continue_label = inc_l, defer_depth = len(g.defers)})
        gen_block(g, v.body)
        pop(&g.loops)
        emit_label(g, inc_l)
        cur2 := fresh(g)
        emit(g, "%s = load %s, ptr %s", cur2, ty, item.ir_name)
        nxt := fresh(g)
        emit(g, "%s = add %s %s, %s", nxt, ty, cur2, step)
        emit(g, "store %s %s, ptr %s", ty, nxt, item.ir_name)
        emit_term(g, "br label %%%s", cond_l)
        emit_label(g, end_l)
        return
    }

    // for item in array_or_slice
    pi := ptr_int(g)
    it := v.iterable.type
    elem: ^Type
    base_ptr, length: string
    #partial switch info in it.info {
    case Array_Type:
        elem = info.elem
        base_ptr = gen_addr(g, v.iterable)
        length = fmt.aprintf("%d", info.len)
    case Slice_Type:
        elem = info.elem
        sv := gen_expr(g, v.iterable)
        base_ptr = fresh(g)
        emit(g, "%s = extractvalue %s %s, 0", base_ptr, slice_ll(g), sv)
        length = fresh(g)
        emit(g, "%s = extractvalue %s %s, 1", length, slice_ll(g), sv)
    case:
        gen_err(g, v.iterable.span, "can't generate a loop over this kind of value yet")
        return
    }

    item.ir_name = alloc_local(g, v.item_name, item.type)
    index_slot := alloc_local(g, "for.i", ty_usize)
    if idx_sym, has_index := g.sema.index_syms[s]; has_index { idx_sym.ir_name = alloc_local(g, v.index_name, ty_usize) }
    emit(g, "store %s 0, ptr %s", pi, index_slot)

    emit_label(g, cond_l)
    i := fresh(g)
    emit(g, "%s = load %s, ptr %s", i, pi, index_slot)
    c := fresh(g)
    emit(g, "%s = icmp ult %s %s, %s", c, pi, i, length)
    emit_term(g, "br i1 %s, label %%%s, label %%%s", c, body_l, end_l)

    emit_label(g, body_l)
    elem_ptr := fresh(g)
    emit(g, "%s = getelementptr inbounds %s, ptr %s, %s %s", elem_ptr, ll_type(g, elem), base_ptr, pi, i)
    if v.by_ref {
        emit(g, "store ptr %s, ptr %s", elem_ptr, item.ir_name)
    } else {
        val := fresh(g)
        emit(g, "%s = load %s, ptr %s", val, ll_type(g, elem), elem_ptr)
        emit(g, "store %s %s, ptr %s", ll_type(g, elem), val, item.ir_name)
    }
    if idx_sym, has_index := g.sema.index_syms[s]; has_index {
        emit(g, "store %s %s, ptr %s", pi, i, idx_sym.ir_name)
    }
    append(&g.loops, Loop_Ctx{break_label = end_l, continue_label = inc_l, defer_depth = len(g.defers)})
    gen_block(g, v.body)
    pop(&g.loops)

    emit_label(g, inc_l)
    i2 := fresh(g)
    emit(g, "%s = load %s, ptr %s", i2, pi, index_slot)
    nxt := fresh(g)
    emit(g, "%s = add %s %s, 1", nxt, pi, i2)
    emit(g, "store %s %s, ptr %s", pi, nxt, index_slot)
    emit_term(g, "br label %%%s", cond_l)
    emit_label(g, end_l)
}

// ===========================================================================
// Addresses (lvalues)
// ===========================================================================

lvalue_volatile :: proc(e: ^Expr) -> bool {
    #partial switch v in e.variant {
    case Unary:
        if v.op == .Deref && v.operand.type != nil {
            if p, ok := v.operand.type.info.(Pointer_Type); ok { return p.volatile }
        }
    case Field:
        if v.base.type != nil {
            if p, ok := v.base.type.info.(Pointer_Type); ok { return p.volatile }
        }
        return lvalue_volatile(v.base)
    case Index:
        return lvalue_volatile(v.base)
    }
    return false
}

// A pointer to where the value of `e` lives. Rvalues are spilled to a temporary.
gen_addr :: proc(g: ^Gen, e: ^Expr) -> string {
    #partial switch v in e.variant {
    case Ident:
        sym := e.sym
        if sym != nil && sym.kind != .Const {
            if sym.is_global { return fmt.aprintf("@%s", symbol_name(sym)) }
            return sym.ir_name
        }
        if sym != nil && !(is_basic(sym.type) || is_pointer(sym.type) || is_enum(sym.type)) {
            return fmt.aprintf("@%s", symbol_name(sym)) // an aggregate const lives in a global
        }
    case Unary:
        if v.op == .Deref { return gen_expr(g, v.operand) } // *p: the address is p itself
    case Index:
        return gen_index_addr(g, v)
    case Field:
        return gen_field_addr(g, v)
    }
    val := gen_expr(g, e)
    tmp := alloc_local(g, "tmp", e.type)
    emit(g, "store %s %s, ptr %s", ll_type(g, e.type), val, tmp)
    return tmp
}

// An index converted to pointer width (sign- or zero-extended by ITS type, so a u8 of 200 stays 200).
gen_index_value :: proc(g: ^Gen, idx: ^Expr) -> string {
    val := gen_expr(g, idx)
    return int_cast(g, val, idx.type, ty_usize)
}

gen_index_addr :: proc(g: ^Gen, v: Index) -> string {
    // TODO: bounds checks (debug builds) would go here
    bt := v.base.type
    idx := gen_index_value(g, v.index)
    pi := ptr_int(g)
    r := fresh(g)
    #partial switch info in bt.info {
    case Array_Type:
        base := gen_addr(g, v.base)
        emit(g, "%s = getelementptr inbounds %s, ptr %s, %s 0, %s %s", r, ll_type(g, bt), base, pi, pi, idx)
    case Slice_Type:
        sv := gen_expr(g, v.base)
        p := fresh(g)
        emit(g, "%s = extractvalue %s %s, 0", p, slice_ll(g), sv)
        emit(g, "%s = getelementptr inbounds %s, ptr %s, %s %s", r, ll_type(g, info.elem), p, pi, idx)
    }
    return r
}

gen_field_addr :: proc(g: ^Gen, v: Field) -> string {
    bt := v.base.type
    base: string
    owner := bt
    if p, ok := bt.info.(Pointer_Type); ok {
        base = gen_expr(g, v.base) // the pointer value
        owner = p.elem
    } else {
        base = gen_addr(g, v.base)
    }
    st := owner.info.(Struct_Type)
    if st.is_union { return base } // every field of a union lives at offset 0
    for f, i in st.fields {
        if f.name == v.name {
            r := fresh(g)
            emit(g, "%s = getelementptr inbounds %s, ptr %s, i32 0, i32 %d", r, ll_type(g, owner), base, i)
            return r
        }
    }
    return base
}

load_lvalue :: proc(g: ^Gen, e: ^Expr) -> string {
    addr := gen_addr(g, e)
    r := fresh(g)
    emit(g, "%s = load %s%s, ptr %s", r, "volatile " if lvalue_volatile(e) else "", ll_type(g, e.type), addr)
    return r
}

// ===========================================================================
// Expressions: each returns the LLVM operand holding the value
// ===========================================================================

gen_expr :: proc(g: ^Gen, e: ^Expr) -> string {
    switch v in e.variant {
    case Int_Lit:  return int_const_text(g, i64(v.value), e.type)
    case Char_Lit: return int_const_text(g, i64(v.value), ty_u8)
    case Bool_Lit: return "true" if v.value else "false"
    case Nil_Lit:  return "null"
    case Str_Lit:
        name, n := make_string_global(g, v.text, v.is_c)
        if v.is_c { return name }
        return fmt.aprintf("{{ ptr %s, %s %d }}", name, ptr_int(g), n)
    case Ident:
        return gen_ident(g, e)
    case Unary:
        return gen_unary(g, e, v)
    case Binary:
        return gen_binary(g, e, v)
    case Ternary:
        return gen_ternary(g, e, v)
    case Call:
        return gen_call(g, e, v)
    case Index:
        return load_lvalue(g, e)
    case Field:
        return gen_field(g, e, v)
    case Slice_Expr:
        return gen_slice_expr(g, e, v)
    case Array_Lit:
        ty := ll_type(g, e.type)
        cur := "zeroinitializer"
        arr := e.type.info.(Array_Type)
        for el, i in v.elems {
            val := gen_expr(g, el)
            r := fresh(g)
            emit(g, "%s = insertvalue %s %s, %s %s, %d", r, ty, cur, ll_type(g, arr.elem), val, i)
            cur = r
        }
        return cur
    case Type_Value:
        gen_err(g, e.span, "a type can't be used as a value")
    }
    return "undef"
}

gen_ident :: proc(g: ^Gen, e: ^Expr) -> string {
    sym := e.sym
    if sym == nil { return "undef" }
    #partial switch sym.kind {
    case .Const:
        if is_basic(sym.type) || is_pointer(sym.type) || is_enum(sym.type) {
            text, _ := gen_const(g, sym.init, sym.type) // scalar consts are inlined
            return text
        }
        r := fresh(g)
        emit(g, "%s = load %s, ptr @%s", r, ll_type(g, sym.type), symbol_name(sym))
        return r
    }
    ptr := sym.ir_name
    if sym.is_global { ptr = fmt.aprintf("@%s", symbol_name(sym)) }
    r := fresh(g)
    emit(g, "%s = load %s, ptr %s", r, ll_type(g, sym.type), ptr)
    return r
}

gen_unary :: proc(g: ^Gen, e: ^Expr, v: Unary) -> string {
    switch v.op {
    case .Neg:
        x := gen_expr(g, v.operand)
        r := fresh(g)
        emit(g, "%s = sub %s 0, %s", r, ll_type(g, e.type), x)
        return r
    case .Bit_Not:
        x := gen_expr(g, v.operand)
        r := fresh(g)
        emit(g, "%s = xor %s %s, -1", r, ll_type(g, e.type), x)
        return r
    case .Not:
        x := gen_expr(g, v.operand)
        r := fresh(g)
        emit(g, "%s = xor i1 %s, true", r, x)
        return r
    case .Deref:
        return load_lvalue(g, e)
    case .Addr:
        return gen_addr(g, v.operand)
    }
    return "undef"
}

gen_binary :: proc(g: ^Gen, e: ^Expr, v: Binary) -> string {
    if v.op == .And || v.op == .Or { return gen_short_circuit(g, v) }
    l := gen_expr(g, v.lhs)
    r := gen_expr(g, v.rhs)
    return gen_binop(g, v.op, l, r, v.lhs.type, v.rhs.type)
}

// `lt` is the operand type (for shifts: the left operand's; `rt` is the shift amount's).
gen_binop :: proc(g: ^Gen, op: Binary_Op, l, r: string, lt, rt: ^Type) -> string {
    ty := ll_type(g, lt)
    signed := is_signed(lt)
    res := fresh(g)
    bin :: proc(g: ^Gen, res, instr, ty, l, r: string) -> string {
        emit(g, "%s = %s %s %s, %s", res, instr, ty, l, r)
        return res
    }
    switch op {
    case .Add:     return bin(g, res, "add", ty, l, r)
    case .Sub:     return bin(g, res, "sub", ty, l, r)
    case .Mul:     return bin(g, res, "mul", ty, l, r)
    case .Div:     return bin(g, res, "sdiv" if signed else "udiv", ty, l, r)
    case .Mod:     return bin(g, res, "srem" if signed else "urem", ty, l, r)
    case .Bit_And: return bin(g, res, "and", ty, l, r)
    case .Bit_Or:  return bin(g, res, "or", ty, l, r)
    case .Bit_Xor: return bin(g, res, "xor", ty, l, r)
    case .Shl, .Shr:
        amount := int_cast(g, r, rt, lt) // LLVM wants both operands the same width. TODO: shifting by >= the width is undefined
        instr := "shl" if op == .Shl else ("ashr" if signed else "lshr")
        return bin(g, res, instr, ty, l, amount)
    case .Floor_Div:
        // like / but rounds toward negative infinity: q = a / b; if the remainder is nonzero and its sign differs from b's, q -= 1
        if !signed { return bin(g, res, "udiv", ty, l, r) }
        q := bin(g, res, "sdiv", ty, l, r)
        rem := fresh(g)
        emit(g, "%s = srem %s %s, %s", rem, ty, l, r)
        nz := fresh(g)
        emit(g, "%s = icmp ne %s %s, 0", nz, ty, rem)
        x := fresh(g)
        emit(g, "%s = xor %s %s, %s", x, ty, rem, r)
        neg := fresh(g)
        emit(g, "%s = icmp slt %s %s, 0", neg, ty, x)
        need := fresh(g)
        emit(g, "%s = and i1 %s, %s", need, nz, neg)
        adj := fresh(g)
        emit(g, "%s = zext i1 %s to %s", adj, need, ty)
        out := fresh(g)
        emit(g, "%s = sub %s %s, %s", out, ty, q, adj)
        return out
    case .Eq:     return bin(g, res, "icmp eq", ty, l, r)
    case .Not_Eq: return bin(g, res, "icmp ne", ty, l, r)
    case .Lt:     return bin(g, res, "icmp slt" if signed else "icmp ult", ty, l, r)
    case .Lt_Eq:  return bin(g, res, "icmp sle" if signed else "icmp ule", ty, l, r)
    case .Gt:     return bin(g, res, "icmp sgt" if signed else "icmp ugt", ty, l, r)
    case .Gt_Eq:  return bin(g, res, "icmp sge" if signed else "icmp uge", ty, l, r)
    case .And, .Or: // handled by gen_short_circuit
    }
    return "undef"
}

// a and b / a or b: the right side only runs if it can change the answer.
gen_short_circuit :: proc(g: ^Gen, v: Binary) -> string {
    l := gen_expr(g, v.lhs)
    rhs_l := new_label(g, "sc.rhs")
    end_l := new_label(g, "sc.end")
    from := g.cur_block
    if v.op == .And {
        emit_term(g, "br i1 %s, label %%%s, label %%%s", l, rhs_l, end_l)
    } else {
        emit_term(g, "br i1 %s, label %%%s, label %%%s", l, end_l, rhs_l)
    }
    emit_label(g, rhs_l)
    r := gen_expr(g, v.rhs)
    from2 := g.cur_block // the right side may have created blocks of its own
    emit_label(g, end_l)
    res := fresh(g)
    emit(g, "%s = phi i1 [ %s, %%%s ], [ %s, %%%s ]", res, "false" if v.op == .And else "true", from, r, from2)
    return res
}

gen_ternary :: proc(g: ^Gen, e: ^Expr, v: Ternary) -> string {
    c := gen_expr(g, v.cond)
    then_l := new_label(g, "tern.then")
    else_l := new_label(g, "tern.else")
    end_l  := new_label(g, "tern.end")
    emit_term(g, "br i1 %s, label %%%s, label %%%s", c, then_l, else_l)
    emit_label(g, then_l)
    a := gen_expr(g, v.then_val)
    a_from := g.cur_block
    emit_term(g, "br label %%%s", end_l)
    emit_label(g, else_l)
    b := gen_expr(g, v.else_val)
    b_from := g.cur_block
    emit_label(g, end_l)
    res := fresh(g)
    emit(g, "%s = phi %s [ %s, %%%s ], [ %s, %%%s ]", res, ll_type(g, e.type), a, a_from, b, b_from)
    return res
}

// A slice value ({ptr, len}) of an array/slice/str; pointers to those are loaded first.
gen_slice_value :: proc(g: ^Gen, base: ^Expr) -> string {
    if is_pointer(base.type) {
        r := fresh(g)
        emit(g, "%s = load %s, ptr %s", r, slice_ll(g), gen_expr(g, base))
        return r
    }
    return gen_expr(g, base)
}

gen_field :: proc(g: ^Gen, e: ^Expr, v: Field) -> string {
    if v.base.type == nil { // Mode.run
        if val, ok := const_int(g, e); ok { return int_const_text(g, val, e.type) }
    }
    bt := v.base.type
    owner := bt
    if p, ok := bt.info.(Pointer_Type); ok { owner = p.elem }

    if v.name == "len" {
        #partial switch info in owner.info {
        case Array_Type:
            return fmt.aprintf("%d", info.len)
        case Slice_Type:
            sv := gen_slice_value(g, v.base)
            r := fresh(g)
            emit(g, "%s = extractvalue %s %s, 1", r, slice_ll(g), sv)
            return r
        case Basic_Type:
            if info.kind == .Str {
                sv := gen_slice_value(g, v.base)
                r := fresh(g)
                emit(g, "%s = extractvalue %s %s, 1", r, slice_ll(g), sv)
                return r
            }
        }
    }
    return load_lvalue(g, e)
}

// a[lo:hi] -> { ptr to a[lo], hi - lo }.  TODO: bounds checks
gen_slice_expr :: proc(g: ^Gen, e: ^Expr, v: Slice_Expr) -> string {
    pi := ptr_int(g)
    bt := v.base.type
    base_ptr, total, elem_ll: string
    #partial switch info in bt.info {
    case Array_Type:
        base_ptr = gen_addr(g, v.base)
        total = fmt.aprintf("%d", info.len)
        elem_ll = ll_type(g, info.elem)
    case Slice_Type:
        sv := gen_expr(g, v.base)
        base_ptr = fresh(g)
        emit(g, "%s = extractvalue %s %s, 0", base_ptr, slice_ll(g), sv)
        total = fresh(g)
        emit(g, "%s = extractvalue %s %s, 1", total, slice_ll(g), sv)
        elem_ll = ll_type(g, info.elem)
    case:
        gen_err(g, e.span, "can't generate a slice of this value yet")
        return "undef"
    }
    lo := "0"
    hi := total
    if v.lo != nil { lo = gen_index_value(g, v.lo) }
    if v.hi != nil { hi = gen_index_value(g, v.hi) }
    p := fresh(g)
    emit(g, "%s = getelementptr inbounds %s, ptr %s, %s %s", p, elem_ll, base_ptr, pi, lo)
    n := fresh(g)
    emit(g, "%s = sub %s %s, %s", n, pi, hi, lo)
    s1 := fresh(g)
    emit(g, "%s = insertvalue %s zeroinitializer, ptr %s, 0", s1, slice_ll(g), p)
    s2 := fresh(g)
    emit(g, "%s = insertvalue %s %s, %s %s, 1", s2, slice_ll(g), s1, pi, n)
    return s2
}

// ===========================================================================
// Calls
// ===========================================================================

gen_call :: proc(g: ^Gen, e: ^Expr, v: Call) -> string {
    if id, ok := v.callee.variant.(Ident); ok {
        switch id.name {
        case "bitcast":
            target := v.args[0].value.type
            val := gen_expr(g, v.args[1].value)
            from := v.args[1].value.type
            r := fresh(g)
            if is_pointer(target) && !is_pointer(from) {
                val = int_cast(g, val, from, ty_usize)
                emit(g, "%s = inttoptr %s %s to ptr", r, ptr_int(g), val)
                return r
            }
            if is_pointer(from) && !is_pointer(target) {
                emit(g, "%s = ptrtoint ptr %s to %s", r, val, ll_type(g, target))
                return r
            }
            return val // same-size integers (or pointer to pointer): the bits are already right
        case "size_of", "align_of":
            size, align := size_align(g, v.args[0].value.type)
            return fmt.aprintf("%d", size if id.name == "size_of" else align)
        }
    }
    sym := v.callee.sym
    if sym == nil { return "undef" }
    #partial switch sym.kind {
    case .Fn:   return gen_fn_call(g, e, v, sym)
    case .Type: return gen_type_call(g, e, v, sym)
    }
    return "undef"
}

gen_fn_call :: proc(g: ^Gen, e: ^Expr, v: Call, sym: ^Symbol) -> string {
    ft := sym.type.info.(Func_Type)
    f := sym.decl.variant.(Fn_Decl)
    n := len(ft.param_types)

    // match arguments to parameters (positional, then by keyword); missing ones use the default
    exprs := make([]^Expr, n)
    defer delete(exprs)
    pos := 0
    for arg in v.args {
        idx := -1
        if arg.name == "" {
            idx = pos
            pos += 1
        } else {
            for nm, j in ft.param_names { if nm == arg.name { idx = j } }
        }
        if idx >= 0 && idx < n { exprs[idx] = arg.value }
    }
    args := strings.builder_make()
    for i in 0 ..< n {
        ex := exprs[i]
        if ex == nil { ex = f.params[i].default }
        val := gen_expr(g, ex)
        if i > 0 { strings.write_string(&args, ", ") }
        fmt.sbprintf(&args, "%s %s", ll_type(g, ft.param_types[i]), val)
    }
    if is_void(ft.ret) {
        emit(g, "call void @%s(%s)", symbol_name(sym), strings.to_string(args))
        return ""
    }
    r := fresh(g)
    emit(g, "%s = call %s @%s(%s)", r, ll_type(g, ft.ret), symbol_name(sym), strings.to_string(args))
    return r
}

// i32(x) conversions and Vec2(1, 2) constructors
gen_type_call :: proc(g: ^Gen, e: ^Expr, v: Call, sym: ^Symbol) -> string {
    target := sym.type
    if st, ok := target.info.(Struct_Type); ok {
        ty := ll_type(g, target)
        cur := "zeroinitializer"
        for arg, i in v.args {
            idx := i
            if arg.name != "" {
                for f, j in st.fields { if f.name == arg.name { idx = j } }
            }
            val := gen_expr(g, arg.value)
            r := fresh(g)
            emit(g, "%s = insertvalue %s %s, %s %s, %d", r, ty, cur, ll_type(g, st.fields[idx].type), val, idx)
            cur = r
        }
        return cur
    }
    arg := v.args[0].value
    val := gen_expr(g, arg)
    return convert(g, val, arg.type, target, e.span)
}
